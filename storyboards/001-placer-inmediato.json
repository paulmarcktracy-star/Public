{
  "id": "001-placer-inmediato",
  "title": "¿Por qué tu cerebro prefiere el placer inmediato antes que tus objetivos a largo plazo?",
  "pillar": 1,
  "format": "secondPerson",
  "evidenceLevel": "solid",
  "sources": [
    {
      "citation": "Frederick, S., Loewenstein, G., & O'Donoghue, T. (2002). Time discounting and time preference: A critical review. Journal of Economic Literature, 40(2), 351–401.",
      "doi": "10.1257/002205102320161311",
      "supports": "Las personas suelen aceptar recompensas menores con tal de recibirlas antes (descuento temporal)."
    },
    {
      "citation": "Kirby, K. N., & Herrnstein, R. J. (1995). Preference reversals due to myopic discounting of delayed reward. Psychological Science, 6(2), 83–89.",
      "doi": "10.1111/j.1467-9280.1995.tb00311.x",
      "supports": "Inversión de preferencias: con la misma diferencia de espera, se elige lo pequeño si está cerca y lo grande si ambas opciones están lejos; la caída de valor es más brusca cerca del presente."
    },
    {
      "citation": "McClure, S. M., Laibson, D. I., Loewenstein, G., & Cohen, J. D. (2004). Separate neural systems value immediate and delayed monetary rewards. Science, 306(5695), 503–507.",
      "doi": "10.1126/science.1100907",
      "supports": "Áreas límbicas de recompensa más activas cuando hay un premio inmediato; mayor actividad fronto-parietal relativa al elegir la opción a más largo plazo."
    },
    {
      "citation": "Kable, J. W., & Glimcher, P. W. (2007). The neural correlates of subjective value during intertemporal choice. Nature Neuroscience, 10, 1625–1633.",
      "doi": "10.1038/nn2007",
      "supports": "Cuestiona el modelo de dos sistemas (nota en pantalla: aún se debate si son uno o dos)."
    },
    {
      "citation": "Rung, J. M., & Madden, G. J. (2018). Experimental reductions of delay discounting and impulsive choice: A systematic review and meta-analysis. Journal of Experimental Psychology: General, 147(9), 1349–1381.",
      "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC6112163",
      "supports": "El pensamiento episódico futuro reduce el descuento temporal (metaanálisis 1)."
    },
    {
      "citation": "Rösch, S. A., Stramaccia, D. F., & Benoit, R. G. (2022). Promoting farsighted decisions via episodic future thinking: A meta-analysis. Journal of Experimental Psychology: General, 151(7), 1606–1635.",
      "doi": "10.1037/xge0001148",
      "supports": "Imaginar el futuro con detalle favorece decisiones con visión de largo plazo (metaanálisis 2)."
    },
    {
      "citation": "Duckworth, A. L., Gendler, T. S., & Gross, J. J. (2016). Situational strategies for self-control. Perspectives on Psychological Science, 11(1), 35–55.",
      "doi": "10.1177/1745691615623247",
      "supports": "Modificar la situación antes de la tentación (p. ej., alejar el celular) es una estrategia de autocontrol."
    },
    {
      "citation": "Ariely, D., & Wertenbroch, K. (2002). Procrastination, deadlines, and performance: Self-control by precommitment. Psychological Science, 13(3), 219–224.",
      "doi": "10.1111/1467-9280.00441",
      "supports": "Comprometerse por adelantado (precompromiso) ayuda a controlar la impulsividad."
    }
  ],
