{
 "id": "004-efecto-espectador",
 "title": "El efecto espectador: ¿más gente significa menos ayuda?",
 "pillar": 3,
 "format": "secondPerson",
 "evidenceLevel": "solid",
 "music": "intimo",
 "sources": [
  {
   "citation": "Darley, J. M., & Latané, B. (1968). Bystander intervention in emergencies: Diffusion of responsibility. Journal of Personality and Social Psychology, 8(4), 377–383.",
   "doi": "10.1037/h0025589",
   "supports": "Quienes creían estar solos ayudaban más que quienes creían que otros también escuchaban (difusión de responsabilidad)."
  },
  {
   "citation": "Fischer, P., et al. (2011). The bystander-effect: A meta-analytic review on bystander intervention in dangerous and non-dangerous emergencies. Psychological Bulletin, 137(4), 517–537.",
   "doi": "10.1037/a0023304",
   "supports": "Metaanálisis: el efecto existe, pero se debilita en emergencias claramente peligrosas."
  },
  {
   "citation": "Philpot, R., Liebst, L. S., Levine, M., Bernasco, W., & Lindegaard, M. R. (2020). Would I be helped? Cross-national CCTV footage shows that intervention is the norm in public conflicts. American Psychologist, 75(1), 66–75.",
   "doi": "10.1037/amp0000469",
   "supports": "219 conflictos reales en tres países: en 9 de cada 10 al menos una persona intervino; más testigos, más probabilidad de ayuda."
  }
 ],
